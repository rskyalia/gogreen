# ============================================================
# Go Green – Monorepo .gitignore
# Backend: Laravel | Frontend: Next.js
# ============================================================

# ─── OS & Editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.orig
.idea/
.vscode/
*.code-workspace

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example

# ─── Backend – Laravel ──────────────────────────────────────
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.*
!backend/.env.example
backend/storage/app/public/*
!backend/storage/app/public/.gitkeep
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/bootstrap/cache/*.php
backend/public/hot
backend/public/storage
backend/database/database.sqlite
backend/*.key

# ─── Frontend – Next.js ─────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/next-env.d.ts

# ─── Build Artifacts ────────────────────────────────────────
dist/
build/
*.log
*.cache

# ─── Package Manager ────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
